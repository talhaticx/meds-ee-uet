---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import { getPosts } from '@/lib/content';
import { formatDate } from '@/lib/format';

const posts = await getPosts();
---

<BaseLayout title="Blog | MEDS (Maktab-e-Digital Systems)" description="Center updates, technical articles, and announcements.">
  <section class="container-shell py-12 sm:py-16 lg:py-20">
    <div class="max-w-3xl space-y-5">
      <span class="eyebrow">Blog</span>
      <h1 class="text-5xl font-bold leading-tight sm:text-6xl">Center updates, technical notes, and announcements.</h1>
      <p class="text-lg leading-8 text-ink/80">
        Follow research progress, lab news, and field notes from the hardware team as projects move from concept to silicon.
      </p>
    </div>
  </section>

  <section class="container-shell py-4 lg:py-8">
    <div class="grid gap-6 lg:grid-cols-2">
      {posts.map((post) => (
        <Card href={`/blog/${post.slug}`}>
          <div class="space-y-4">
            <div class="aspect-[16/9] overflow-hidden rounded-2xl bg-peach">
              {post.mainImageUrl ? <img src={post.mainImageUrl} alt={post.mainImageAlt ?? post.title} class="h-full w-full object-cover" loading="lazy" /> : null}
            </div>
            <p class="text-xs uppercase tracking-[0.18em] text-ink/55">{formatDate(post.publishedAt)}</p>
            <h2 class="text-2xl font-bold text-brand">{post.title}</h2>
            <p class="text-sm leading-7 text-ink/75">{post.bodyText?.slice(0, 170) ?? 'Read the latest technical write-up from the center.'}</p>
            <p class="text-sm font-medium text-ink/60">{post.author?.name ?? 'Center Editorial'}</p>
          </div>
        </Card>
      ))}
    </div>
  </section>
</BaseLayout>
