---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import { getPosts } from '@/lib/content';
import { formatDate } from '@/lib/format';

const posts = await getPosts();
---

<BaseLayout title="Blog | MEDS (Maktab-e-Digital Systems)" description="Center updates, technical articles, and announcements.">
  <section class="page-hero">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-deep via-brand-dark to-brand"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute bottom-0 left-0 w-[350px] h-[350px] rounded-full bg-mauve/8 blur-[120px]"></div>
    <div class="container-shell relative z-10">
      <div class="max-w-3xl space-y-5">
        <span class="eyebrow">Blog</span>
        <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">Center updates, technical notes, and announcements.</h1>
        <p class="text-lg leading-8">
          Follow research progress, lab news, and field notes from the hardware team as projects move from concept to silicon.
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
        <path d="M0 60V40C240 10 480 0 720 0C960 0 1200 10 1440 40V60H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <section class="container-shell py-12 lg:py-16">
    <div class="grid gap-6 lg:grid-cols-2">
      {posts.map((post) => (
        <Card href={`/meds-ee-uet/blog/${post.slug}`}>
          <div class="space-y-4">
            <div class="aspect-[16/9] overflow-hidden rounded-2xl bg-peach">
              {post.mainImageUrl ? <img src={post.mainImageUrl} alt={post.mainImageAlt ?? post.title} class="h-full w-full object-cover" loading="lazy" /> : null}
            </div>
            <p class="text-xs uppercase tracking-[0.18em] text-ink/55">{formatDate(post.publishedAt)}</p>
            <h2 class="text-2xl font-bold text-brand">{post.title}</h2>
            <p class="text-sm leading-7 text-ink/75">{post.bodyText?.slice(0, 170) ?? 'Read the latest technical write-up from the center.'}</p>
            <p class="text-sm font-medium text-ink/60">{post.author?.name ?? post.rawAuthor ?? 'Center Editorial'}</p>
          </div>
        </Card>
      ))}
    </div>
  </section>
</BaseLayout>
