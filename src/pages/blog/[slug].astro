---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import { getPosts } from '@/lib/content';
import { formatDate } from '@/lib/format';
import { render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Awaited<ReturnType<typeof getPosts>>[number] };
const { Content } = await render(post.entry);
---

<BaseLayout title={`${post.title} | Blog`} description={post.bodyText?.slice(0, 160) ?? post.title}>
  <section class="container-shell py-12 sm:py-16 lg:py-20">
    <div class="max-w-4xl space-y-6">
      <p class="eyebrow">Blog post</p>
      <h1 class="text-5xl font-bold leading-tight sm:text-6xl">{post.title}</h1>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-ink/65">
        <span>{formatDate(post.publishedAt)}</span>
        <span>{post.author?.name ?? 'Center Editorial'}</span>
        {post.author?.role ? <span>{post.author.role}</span> : null}
      </div>
    </div>
  </section>

  <section class="container-shell grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-start">
    <div class="space-y-8">
      {post.mainImageUrl ? (
        <div class="overflow-hidden rounded-3xl border border-mauve bg-white shadow-soft">
          <img src={post.mainImageUrl} alt={post.mainImageAlt ?? post.title} class="h-auto w-full object-cover" />
        </div>
      ) : null}

      <article class="surface px-6 py-8 sm:px-8">
        <Content />
      </article>
    </div>

    <aside class="space-y-6 lg:sticky lg:top-24">
      <Card>
        <p class="eyebrow">Author</p>
        <h2 class="mt-4 text-2xl font-bold text-brand">{post.author?.name ?? 'Center Editorial'}</h2>
        <p class="mt-3 text-sm leading-7 text-ink/75">{post.author?.bio ?? 'Technical writing and announcements from the center.'}</p>
        {post.author?.linkedin ? (
          <a href={post.author.linkedin} target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-semibold text-brand hover:text-brand/80">
            LinkedIn profile
          </a>
        ) : null}
      </Card>

      <Card>
        <p class="eyebrow">Back to blog</p>
        <p class="mt-4 text-sm leading-7 text-ink/75">Browse more research notes, announcements, and milestone updates from the center.</p>
        <div class="mt-5">
          <Button href="/blog" variant="secondary">All blog posts</Button>
        </div>
      </Card>
    </aside>
  </section>
</BaseLayout>
