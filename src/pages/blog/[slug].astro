---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import { getPosts } from '@/lib/content';
import { formatDate } from '@/lib/format';
import { render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Awaited<ReturnType<typeof getPosts>>[number] };
const { Content } = await render(post.entry);
---

<BaseLayout title={`${post.title} | Blog`} description={post.bodyText?.slice(0, 160) ?? post.title}>
  <section class="page-hero">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-deep via-brand-dark to-brand"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="container-shell relative z-10">
      <div class="max-w-4xl space-y-6">
        <p class="eyebrow">Blog post</p>
        <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">{post.title}</h1>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-white/60">
          <span>{formatDate(post.publishedAt)}</span>
          <span>{post.author?.name ?? post.rawAuthor ?? 'Center Editorial'}</span>
          {post.author?.role ? <span>{post.author.role}</span> : null}
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
      <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-8 sm:h-12" preserveAspectRatio="none">
        <path d="M0 60V30C360 45 1080 15 1440 30V60H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <section class="container-shell py-8 sm:py-12 grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-start min-w-0 max-w-full">
    <div class="space-y-8 min-w-0 max-w-full">
      {post.mainImageUrl ? (
        <div class="overflow-hidden rounded-3xl border border-mauve bg-white shadow-soft">
          <img src={post.mainImageUrl} alt={post.mainImageAlt ?? post.title} class="h-auto w-full object-cover" />
        </div>
      ) : null}

      <article class="surface px-4 py-6 sm:px-8 sm:py-8 prose-custom min-w-0 max-w-full">
        <Content />
      </article>
    </div>

    <aside class="space-y-6 lg:sticky lg:top-24">
      <Card>
        <p class="eyebrow">Author</p>
        <h2 class="mt-4 text-2xl font-bold text-brand">{post.author?.name ?? post.rawAuthor ?? 'Center Editorial'}</h2>
        <p class="mt-3 text-sm leading-7 text-ink/75">{post.author?.bio ?? 'Technical writing and announcements from the center.'}</p>
        {post.author?.linkedin ? (
          <a href={post.author.linkedin} target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-semibold text-brand hover:text-brand/80">
            LinkedIn profile
          </a>
        ) : null}
      </Card>

      <Card>
        <p class="eyebrow">Back to blog</p>
        <p class="mt-4 text-sm leading-7 text-ink/75">Browse more research notes, announcements, and milestone updates from the center.</p>
        <div class="mt-5">
          <Button href="/meds-ee-uet/blog" variant="secondary">All blog posts</Button>
        </div>
      </Card>
    </aside>
  </section>
</BaseLayout>
