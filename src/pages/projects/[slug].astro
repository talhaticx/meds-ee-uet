---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import { getProjects } from '@/lib/content';
import { render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Awaited<ReturnType<typeof getProjects>>[number] };
const { Content } = await render(project.entry);
---

<BaseLayout title={`${project.title} | Projects`} description={project.abstract}>
  <section class="container-shell py-12 sm:py-16 lg:py-20">
    <div class="max-w-4xl space-y-6">
      <p class="eyebrow">Project detail</p>
      <h1 class="text-5xl font-bold leading-tight sm:text-6xl">{project.title}</h1>
      <div class="flex flex-wrap items-center gap-3">
        <span class={`rounded-full px-3 py-1 text-xs font-semibold ${project.status === 'Active' ? 'bg-peach text-brand' : 'bg-mauve text-brand'}`}>{project.status}</span>
        {project.techStack.map((tech) => <span class="rounded-full border border-mauve bg-white px-3 py-1 text-xs font-medium text-ink/70">{tech}</span>)}
      </div>
      <p class="text-lg leading-8 text-ink/80">{project.abstract}</p>
    </div>
  </section>

  <section class="container-shell grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-start">
    <div class="space-y-8">
      {project.heroImageUrl ? (
        <div class="overflow-hidden rounded-3xl border border-mauve bg-white shadow-soft">
          <img src={project.heroImageUrl} alt={project.heroImageAlt ?? project.title} class="h-auto w-full object-cover" />
        </div>
      ) : null}

      <article class="surface px-6 py-8 sm:px-8">
        <Content />
      </article>
    </div>

    <aside class="space-y-6 lg:sticky lg:top-24">
      <Card>
        <p class="eyebrow">Tech stack</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {project.techStack.map((tech) => (
            <span class="rounded-full bg-peach px-3 py-1 text-xs font-semibold text-brand">{tech}</span>
          ))}
        </div>
      </Card>

      <Card>
        <p class="eyebrow">More projects</p>
        <p class="mt-4 text-sm leading-7 text-ink/75">See other tape-out programs, FPGA accelerators, and instrumentation work from the center.</p>
        <div class="mt-5">
          <Button href="/meds-ee-uet/projects" variant="secondary">Project index</Button>
        </div>
      </Card>
    </aside>
  </section>
</BaseLayout>
