---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import { getProjects } from '@/lib/content';

const projects = await getProjects();

const completedCount = projects.filter((p) => p.status === 'Completed').length;
const inProgressCount = projects.filter((p) => p.status === 'In Progress' || p.status === 'Active').length;

function getLinkMeta(url?: string) {
  if (!url || url.includes('github.com')) {
    return { label: 'GitHub Repository', isGithub: true };
  }
  if (url.includes('drive.google.com') || url.includes('sharepoint.com')) {
    return { label: 'Document / Report', isDoc: true };
  }
  if (url.includes('riscv-europe.org')) {
    return { label: 'Conference Poster', isPoster: true };
  }
  if (url.includes('ee.uet.edu.pk')) {
    return { label: 'Project Article', isWeb: true };
  }
  return { label: 'Project Repository', isGithub: true };
}
---

<BaseLayout title="Projects | MEDS (Maktab-e-Digital Systems)" description="Explore research projects, RISC-V cores, FPGA accelerators, and verification IPs developed at MEDS.">
  <!-- Hero header -->
  <section class="page-hero">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-deep via-brand-dark to-brand"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full bg-peach/8 blur-[120px]"></div>
    <div class="container-shell relative z-10">
      <div class="max-w-3xl space-y-5">
        <span class="eyebrow">Research & Innovation</span>
        <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">Hardware Projects & Silicon IPs</h1>
        <p class="text-lg leading-8 text-white/90">
          A comprehensive showcase of our RISC-V cores, SoC architectures, verification frameworks, and hardware acceleration designs built by faculty and research engineers.
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
      <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-8 sm:h-12" preserveAspectRatio="none">
        <path d="M0 60V30C360 45 1080 15 1440 30V60H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Summary bar -->
  <section class="container-shell -mt-6 relative z-20">
    <div class="surface rounded-2xl p-4 sm:p-6 shadow-md border border-slate-200/80 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-ink/60 block">Total Projects</span>
          <span class="text-2xl font-extrabold text-brand">{projects.length}</span>
        </div>
        <div class="h-8 w-[1px] bg-slate-200"></div>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-ink/60 block">Completed</span>
          <span class="text-2xl font-extrabold text-emerald-600">{completedCount}</span>
        </div>
        <div class="h-8 w-[1px] bg-slate-200"></div>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-ink/60 block">In Progress</span>
          <span class="text-2xl font-extrabold text-amber-600">{inProgressCount}</span>
        </div>
      </div>
      <div class="text-xs text-ink/60 font-medium">
        Filter or browse through all active & completed lab initiatives below.
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="container-shell py-12 lg:py-16">
    <div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => {
        const linkMeta = getLinkMeta(project.link);
        return (
          <div class="group relative flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm hover:shadow-xl hover:border-brand/40 hover:-translate-y-1 transition-all duration-300">
            <div>
              {/* Header: Title & Status */}
              <div class="flex items-start justify-between gap-3 mb-4">
                <h2 class="text-xl font-bold text-brand-dark group-hover:text-brand transition-colors leading-snug">
                  {project.title}
                </h2>
                <span class={`shrink-0 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-extrabold ${
                  project.status === 'Completed'
                    ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                    : 'bg-amber-50 text-amber-700 border border-amber-200'
                }`}>
                  <span class={`h-2 w-2 rounded-full ${project.status === 'Completed' ? 'bg-emerald-500' : 'bg-amber-500 animate-pulse'}`}></span>
                  {project.status}
                </span>
              </div>

              {/* Members */}
              {project.members && (
                <div class="mt-4 pt-4 border-t border-slate-100">
                  <div class="flex items-start gap-2.5 text-xs text-ink/80">
                    <svg class="w-4 h-4 shrink-0 text-brand mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    <div>
                      <span class="font-bold text-brand block text-[11px] uppercase tracking-wider">Team</span>
                      <span class="font-medium text-ink/90 leading-relaxed">{project.members}</span>
                    </div>
                  </div>
                </div>
              )}

              {/* Advisor */}
              {project.advisor && (
                <div class="mt-3">
                  <div class="flex items-start gap-2.5 text-xs text-ink/80">
                    <svg class="w-4 h-4 shrink-0 text-brand-dark mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 0h4m-4 0V3" />
                    </svg>
                    <div>
                      <span class="font-bold text-brand-dark block text-[11px] uppercase tracking-wider">Advisor / Supervisor</span>
                      <span class="font-medium text-ink/90">{project.advisor}</span>
                    </div>
                  </div>
                </div>
              )}
            </div>

            <!-- Footer Action Link -->
            <div class="mt-6 pt-4 border-t border-slate-100">
              <a
                href={project.link || 'https://github.com/meds-uet'}
                target="_blank"
                rel="noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-slate-50 hover:bg-brand hover:text-white px-4 py-2.5 text-xs font-bold text-brand border border-slate-200/80 group-hover:border-brand/30 transition-all duration-200"
              >
                {linkMeta.isGithub && (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                )}
                {linkMeta.isDoc && (
                  <svg class="w-4 h-4 fill-none stroke-currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                )}
                {linkMeta.isPoster && (
                  <svg class="w-4 h-4 fill-none stroke-currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2zM12 7v10m-4-4h8"/>
                  </svg>
                )}
                {linkMeta.isWeb && (
                  <svg class="w-4 h-4 fill-none stroke-currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>
                  </svg>
                )}
                <span>{linkMeta.label}</span>
                <svg class="w-3.5 h-3.5 fill-none stroke-currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
