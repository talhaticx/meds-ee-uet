---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import { getProjects } from '@/lib/content';

const projects = await getProjects();
---

<BaseLayout title="Projects | MEDS (Maktab-e-Digital Systems)" description="Hardware designs, processor tape-outs, and FPGA accelerators.">
  <section class="page-hero">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-deep via-brand-dark to-brand"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full bg-peach/8 blur-[120px]"></div>
    <div class="container-shell relative z-10">
      <div class="max-w-3xl space-y-5">
        <span class="eyebrow">Projects</span>
        <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">Research hardware programs from first RTL to tape-out readiness.</h1>
        <p class="text-lg leading-8">
          Explore active and completed designs spanning processor cores, accelerator fabrics, and instrumentation tooling used across the lab.
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
      <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-8 sm:h-12" preserveAspectRatio="none">
        <path d="M0 60V30C360 45 1080 15 1440 30V60H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <section class="container-shell py-12 lg:py-16">
    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <Card href={`/meds-ee-uet/projects/${project.slug}`}>
          <div class="space-y-4">
            <div class="aspect-[16/9] overflow-hidden rounded-2xl bg-peach">
              {project.heroImageUrl ? <img src={project.heroImageUrl} alt={project.heroImageAlt ?? project.title} class="h-full w-full object-cover" loading="lazy" /> : null}
            </div>
            <div class="flex items-center justify-between gap-3">
              <span class={`rounded-full px-3 py-1 text-xs font-semibold ${project.status === 'Active' ? 'bg-peach text-brand' : 'bg-mauve text-brand'}`}>{project.status}</span>
              <span class="text-xs uppercase tracking-[0.18em] text-ink/55">{project.techStack.join(' · ')}</span>
            </div>
            <h2 class="text-2xl font-bold text-brand">{project.title}</h2>
            <p class="text-sm leading-7 text-ink/75">{project.abstract}</p>
          </div>
        </Card>
      ))}
    </div>
  </section>
</BaseLayout>
