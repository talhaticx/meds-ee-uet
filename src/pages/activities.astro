---
import BaseLayout from '@/layouts/BaseLayout.astro';

const linkedInPosts = [
  {
    author: "Maktab-e-Digital Systems (MEDS)",
    tagline: "Digital Design & Verification Research Center · UET Lahore",
    date: "Latest Update",
    category: "Silicon Tape-Out",
    badgeColor: "bg-emerald-500/10 text-emerald-700 border-emerald-500/20",
    content: "Excited to share the physical design and ASIC flow of UET-RVMCU, our streamlined open-source RISC-V microcontroller! Developed at MEDS UET Lahore to democratize open hardware design in Pakistan.",
    hashtags: ["#RISCV", "#OpenSourceHardware", "#PhysicalDesign", "#ASIC", "#UETLahore", "#DigitalDesign"],
    stats: { likes: 184, comments: 24, reposts: 19 },
    link: "https://www.linkedin.com/company/meds-uet/"
  },
  {
    author: "Maktab-e-Digital Systems (MEDS)",
    tagline: "Digital Design & Verification Research Center · UET Lahore",
    date: "Featured Workshop",
    category: "Hands-on Training",
    badgeColor: "bg-brand/10 text-brand border-brand/20",
    content: "Successfully conducted our hands-on Verilator and RISC-V SoC bring-up training session! Undergraduates and junior researchers gained practical experience in Verilog simulation, Makefile automation, and testbench design.",
    hashtags: ["#Verilator", "#DigitalDesign", "#Verification", "#FPGA", "#HardwareEngineering", "#Education"],
    stats: { likes: 142, comments: 18, reposts: 12 },
    link: "https://www.linkedin.com/company/meds-uet/"
  },
  {
    author: "Maktab-e-Digital Systems (MEDS)",
    tagline: "Digital Design & Verification Research Center · UET Lahore",
    date: "Research Milestone",
    category: "Academic Publication",
    badgeColor: "bg-purple-500/10 text-purple-700 border-purple-500/20",
    content: "Proud to announce our latest research paper on Gem5 simulation & architectural evaluation of the CVA6 RISC-V core has been published in IEEE Access! Congratulations to the authors and research team at MEDS.",
    hashtags: ["#IEEE", "#ComputerArchitecture", "#Gem5", "#CVA6", "#RISCV", "#AcademicResearch"],
    stats: { likes: 210, comments: 31, reposts: 28 },
    link: "https://www.linkedin.com/company/meds-uet/"
  }
];
---

<BaseLayout title="Activities & News | MEDS (Maktab-e-Digital Systems)" description="Stay up to date with official activities, workshops, tape-outs, and events posted on the MEDS LinkedIn page.">
  <!-- Hero Section -->
  <section class="page-hero">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-deep via-brand-dark to-brand"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute bottom-0 right-0 w-[350px] h-[350px] rounded-full bg-peach/8 blur-[100px]"></div>
    <div class="container-shell relative z-10">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 backdrop-blur-sm border border-white/15">
          <svg class="w-4 h-4 text-[#0A66C2] fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.47 1.47 0 1 0 1.47 1.47c0-.81-.66-1.47-1.47-1.47Z"/>
          </svg>
          <span class="text-xs font-semibold text-white tracking-wide uppercase">Official LinkedIn Feed</span>
        </div>
        <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">Activities & Lab Updates</h1>
        <p class="text-lg leading-8 text-white/90">
          Stay connected with Maktab-e-Digital Systems (MEDS). All our official announcements, silicon tape-out updates, workshops, and research milestones are published on LinkedIn.
        </p>
        <div class="pt-2">
          <a
            href="https://www.linkedin.com/company/meds-uet/"
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-3 rounded-2xl bg-[#0A66C2] px-6 py-3.5 text-sm font-bold text-white shadow-lg hover:bg-[#084e96] hover:shadow-xl transition-all duration-200"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.47 1.47 0 1 0 1.47 1.47c0-.81-.66-1.47-1.47-1.47Z"/>
            </svg>
            <span>Follow MEDS on LinkedIn</span>
            <svg class="w-4 h-4 fill-none stroke-currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
      <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-8 sm:h-12" preserveAspectRatio="none">
        <path d="M0 60V30C360 45 1080 15 1440 30V60H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Feed Banner & Embed Showcase Section -->
  <section class="container-shell py-12 lg:py-16">
    <div class="grid gap-8 lg:grid-cols-3">
      <!-- Main Feed Column -->
      <div class="lg:col-span-2 space-y-6">
        <!-- LinkedIn Page Card Header -->
        <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-brand flex items-center justify-center text-white shadow-md shrink-0">
                <svg class="w-8 h-8 fill-current text-[#0A66C2]" viewBox="0 0 24 24">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.47 1.47 0 1 0 1.47 1.47c0-.81-.66-1.47-1.47-1.47Z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xl font-bold text-brand-dark">Maktab-e-Digital Systems (MEDS)</h2>
                <p class="text-xs font-medium text-ink/65 mt-0.5">Digital Design & Verification Research Center · UET Lahore</p>
              </div>
            </div>
            <a
              href="https://www.linkedin.com/company/meds-uet/"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#0A66C2] px-5 py-2.5 text-xs font-bold text-white hover:bg-[#084e96] transition-colors shrink-0 shadow-sm"
            >
              <span>+ Follow Page</span>
            </a>
          </div>

          <div class="mt-4 flex items-center justify-between text-xs text-ink/70">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Live Updates & Post Stream
            </span>
            <a href="https://www.linkedin.com/company/meds-uet/" target="_blank" rel="noreferrer" class="text-[#0A66C2] font-semibold hover:underline">
              linkedin.com/company/meds-uet
            </a>
          </div>
        </div>

        <!-- Featured Post Cards Stream -->
        <div class="space-y-5">
          {linkedInPosts.map((post) => (
            <div class="rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
              <!-- Post Author Header -->
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-brand text-white flex items-center justify-center font-bold text-sm shrink-0">
                    M
                  </div>
                  <div>
                    <h3 class="text-sm font-bold text-brand-dark">{post.author}</h3>
                    <p class="text-[11px] text-ink/60">{post.tagline}</p>
                  </div>
                </div>
                <span class={`text-[11px] font-semibold px-3 py-1 rounded-full border ${post.badgeColor}`}>
                  {post.category}
                </span>
              </div>

              <!-- Post Body -->
              <p class="text-sm text-ink/85 leading-relaxed mb-3">
                {post.content}
              </p>

              <!-- Hashtags -->
              <div class="flex flex-wrap gap-1.5 mb-5">
                {post.hashtags.map((tag) => (
                  <span class="text-[11px] font-medium text-[#0A66C2] hover:underline cursor-pointer">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Post Footer & CTA -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-4 text-xs font-semibold text-ink/60">
                  <span class="flex items-center gap-1">
                    👍 {post.stats.likes}
                  </span>
                  <span>💬 {post.stats.comments}</span>
                  <span>🔄 {post.stats.reposts}</span>
                </div>
                <a
                  href={post.link}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0A66C2] hover:underline"
                >
                  <span>View Post on LinkedIn</span>
                  <svg class="w-3.5 h-3.5 fill-none stroke-currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Big Banner to LinkedIn -->
        <div class="rounded-3xl border border-slate-200/90 bg-slate-50 p-8 text-center space-y-4">
          <div class="w-14 h-14 rounded-full bg-[#0A66C2]/10 text-[#0A66C2] mx-auto flex items-center justify-center">
            <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.47 1.47 0 1 0 1.47 1.47c0-.81-.66-1.47-1.47-1.47Z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-brand-dark">See All Posts & Discussions on LinkedIn</h3>
          <p class="text-xs text-ink/70 max-w-md mx-auto leading-relaxed">
            Our LinkedIn community features live event photos, student project reels, silicon tape-out updates, and discussions with researchers worldwide.
          </p>
          <div class="pt-2">
            <a
              href="https://www.linkedin.com/company/meds-uet/"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-2 rounded-2xl bg-[#0A66C2] px-6 py-3 text-xs font-bold text-white shadow hover:bg-[#084e96] transition-all"
            >
              <span>Explore Official LinkedIn Page</span>
              <svg class="w-4 h-4 fill-none stroke-currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Sidebar Highlights & Information -->
      <div class="space-y-6">
        <!-- Highlights Box -->
        <div class="rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-bold text-brand-dark mb-4 pb-3 border-b border-slate-100">
            What We Share on LinkedIn
          </h3>

          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-brand/10 text-brand flex items-center justify-center shrink-0 font-bold text-xs">
                01
              </div>
              <div>
                <h4 class="text-xs font-bold text-brand-dark">RISC-V & SoC Workshops</h4>
                <p class="text-xs text-ink/70 mt-0.5">Hands-on student training, Verilator, and FPGA bring-up sessions.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-700 flex items-center justify-center shrink-0 font-bold text-xs">
                02
              </div>
              <div>
                <h4 class="text-xs font-bold text-brand-dark">Silicon Tape-Out Milestones</h4>
                <p class="text-xs text-ink/70 mt-0.5">Announcements of open-source RISC-V cores and tape-out successes.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-700 flex items-center justify-center shrink-0 font-bold text-xs">
                03
              </div>
              <div>
                <h4 class="text-xs font-bold text-brand-dark">Student Achievements & FYPs</h4>
                <p class="text-xs text-ink/70 mt-0.5">Celebrating student research papers, competitions, and graduations.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-700 flex items-center justify-center shrink-0 font-bold text-xs">
                04
              </div>
              <div>
                <h4 class="text-xs font-bold text-brand-dark">Industrial & Open-Source News</h4>
                <p class="text-xs text-ink/70 mt-0.5">Collaborations with global open-source hardware communities.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Join Community Box -->
        <div class="rounded-3xl border border-brand/20 bg-gradient-to-br from-brand-dark to-brand p-6 text-white shadow-md">
          <h3 class="text-lg font-bold">Connect with MEDS</h3>
          <p class="text-xs text-white/80 mt-2 leading-relaxed">
            Follow our official page to interact with research engineers, directors, and alumni working across digital design and verification.
          </p>
          <div class="mt-5">
            <a
              href="https://www.linkedin.com/company/meds-uet/"
              target="_blank"
              rel="noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-white text-brand-dark px-4 py-2.5 text-xs font-bold hover:bg-peach transition-colors shadow"
            >
              <span>Follow @meds-uet</span>
              <svg class="w-3.5 h-3.5 fill-none stroke-currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
