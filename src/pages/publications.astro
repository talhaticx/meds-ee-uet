---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import Button from '@/components/Button.astro';
import { getPublications } from '@/lib/content';
import { formatDate } from '@/lib/format';

const publications = await getPublications();
---

<BaseLayout title="Publications | MEDS (Maktab-e-Digital Systems)" description="Published research papers with IEEE or PDF links.">
  <section class="page-hero">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-deep via-brand-dark to-brand"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] rounded-full bg-mauve/8 blur-[100px]"></div>
    <div class="container-shell relative z-10">
      <div class="max-w-3xl space-y-5">
        <span class="eyebrow">Publications</span>
        <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">Research papers and published outcomes from the center.</h1>
        <p class="text-lg leading-8">
          Browse journal articles, conference papers, and downloadable PDFs tied to the lab's silicon and accelerator work.
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
        <path d="M0 60V40C240 10 480 0 720 0C960 0 1200 10 1440 40V60H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <section class="container-shell py-12 lg:py-16">
    <div class="space-y-4">
      {publications.map((publication) => (
        <Card>
          <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
            <div class="space-y-2">
              <p class="text-xs uppercase tracking-[0.18em] text-ink/55">{formatDate(publication.publishedDate, { month: 'short', year: 'numeric' })}</p>
              <h2 class="text-2xl font-bold text-brand">{publication.title}</h2>
              <p class="text-sm leading-7 text-ink/75">{publication.authors}</p>
              <p class="text-sm font-medium text-ink/60">{publication.venue}</p>
            </div>
            <Button href={publication.link} variant="secondary">View paper</Button>
          </div>
        </Card>
      ))}
    </div>
  </section>
</BaseLayout>
