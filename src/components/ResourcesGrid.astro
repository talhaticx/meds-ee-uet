---
import type { Post, Activity } from '../lib/types';
import { formatDate } from '../lib/format';

interface Props {
  posts: Post[];
  activities: Activity[];
}

const { posts, activities } = Astro.props;
---

<section class="section-light py-20 lg:py-28" id="resources-section">
  <div class="container-shell">
    <div class="text-center animate-on-scroll">
      <span class="eyebrow">Resources</span>
      <h2 class="mt-6 text-3xl font-bold text-brand sm:text-4xl lg:text-5xl">Explore Our Work</h2>
      <p class="mt-4 text-lg text-ink/60 max-w-2xl mx-auto">Publications, updates, and events from the MEDS research community.</p>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      <!-- Latest Blog Posts -->
      <div class="animate-on-scroll delay-1">
        <div class="group rounded-2xl border border-mauve/60 bg-white p-6 transition-all duration-300 hover:border-brand/20 hover:shadow-[0_16px_48px_rgba(89,46,92,0.1)] hover:-translate-y-1 h-full flex flex-col">
          <div class="aspect-[16/10] overflow-hidden rounded-xl bg-peach mb-5">
            {posts[0]?.mainImageUrl ? (
              <img src={posts[0].mainImageUrl} alt={posts[0].title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            ) : (
              <div class="h-full w-full bg-gradient-to-br from-peach to-mauve flex items-center justify-center">
                <svg class="w-12 h-12 text-brand/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z" /></svg>
              </div>
            )}
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-brand/60">Blog Posts</span>
          <h3 class="mt-2 text-xl font-bold text-brand">{posts[0]?.title || 'Latest Updates'}</h3>
          <p class="mt-2 text-sm text-ink/60 leading-relaxed flex-grow">{posts[0]?.bodyText?.slice(0, 100) || 'Read the latest technical notes and research progress from MEDS.'}</p>
          <a href="/meds-ee-uet/blog" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-light transition-colors group/link">
            Read updates
            <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
        </div>
      </div>

      <!-- Publications -->
      <div class="animate-on-scroll delay-2">
        <div class="group rounded-2xl border border-mauve/60 bg-white p-6 transition-all duration-300 hover:border-brand/20 hover:shadow-[0_16px_48px_rgba(89,46,92,0.1)] hover:-translate-y-1 h-full flex flex-col">
          <div class="aspect-[16/10] overflow-hidden rounded-xl bg-gradient-to-br from-brand-dark to-brand mb-5 flex items-center justify-center">
            <svg class="w-16 h-16 text-peach/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-brand/60">Research</span>
          <h3 class="mt-2 text-xl font-bold text-brand">Publications</h3>
          <p class="mt-2 text-sm text-ink/60 leading-relaxed flex-grow">Browse our published research papers, conference proceedings, and technical reports.</p>
          <a href="/meds-ee-uet/publications" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-light transition-colors group/link">
            View publications
            <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
        </div>
      </div>

      <!-- Lab Activities -->
      <div class="animate-on-scroll delay-3">
        <div class="group rounded-2xl border border-mauve/60 bg-white p-6 transition-all duration-300 hover:border-brand/20 hover:shadow-[0_16px_48px_rgba(89,46,92,0.1)] hover:-translate-y-1 h-full flex flex-col">
          <div class="aspect-[16/10] overflow-hidden rounded-xl bg-peach mb-5">
            {activities[0]?.imageGallery[0]?.url ? (
              <img src={activities[0].imageGallery[0].url} alt={activities[0].title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            ) : (
              <div class="h-full w-full bg-gradient-to-br from-peach to-brand/10 flex items-center justify-center">
                <svg class="w-12 h-12 text-brand/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
              </div>
            )}
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-brand/60">Events</span>
          <h3 class="mt-2 text-xl font-bold text-brand">{activities[0]?.title || 'Lab Activities'}</h3>
          <p class="mt-2 text-sm text-ink/60 leading-relaxed flex-grow">{activities[0]?.description?.slice(0, 100) || 'Workshops, hack nights, and lab sessions from the MEDS community.'}</p>
          <a href="/meds-ee-uet/activities" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-light transition-colors group/link">
            See events
            <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
