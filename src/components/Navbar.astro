---
const links = [
  { href: '/meds-ee-uet/', label: 'Home' },
  { href: '/meds-ee-uet/about', label: 'About' },
  { href: '/meds-ee-uet/blog', label: 'Blog' },
  { href: '/meds-ee-uet/projects', label: 'Projects' },
  { href: '/meds-ee-uet/publications', label: 'Publications' },
  { href: '/meds-ee-uet/activities', label: 'Activities' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-mauve/70 bg-white/90 backdrop-blur-xl">
  <div class="container-shell flex h-20 items-center justify-between gap-6">
    <a href="/meds-ee-uet/" class="flex items-center gap-3">
      <img src="/meds-ee-uet/images/meds_uet_logo.jpeg" alt="MEDS Logo" class="h-11 w-11 rounded-2xl object-cover shadow-soft" />
      <div>
        <p class="font-display text-sm font-bold tracking-[0.18em] text-brand uppercase">MEDS</p>
        <p class="text-xs text-ink/65">Maktab-e-Digital Systems</p>
      </div>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      {links.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a href={link.href} class={`rounded-full px-4 py-2 text-sm font-medium transition ${isActive ? 'bg-brand text-white' : 'text-ink/75 hover:bg-peach hover:text-brand'}`}>
            {link.label}
          </a>
        );
      })}
    </nav>


  </div>
</header>
