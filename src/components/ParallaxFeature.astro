---
// Parallax feature section with fixed background image
---

<section class="relative overflow-hidden" id="parallax-section">
  <!-- Parallax background -->
  <div 
    class="parallax-bg absolute inset-0"
    style="background-image: url('/meds-ee-uet/images/parallax-bg.png');"
  ></div>
  
  <!-- Dark overlay using brand color -->
  <div class="absolute inset-0 bg-brand/85"></div>
  
  <!-- Top curved edge -->
  <div class="absolute top-0 left-0 right-0 z-10">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
      <path d="M0 0V20C360 60 720 60 1080 40C1260 30 1380 20 1440 10V0H0Z" fill="#3D1F40"/>
    </svg>
  </div>

  <div class="container-shell relative z-10 py-32 lg:py-44 text-center">
    <div class="max-w-3xl mx-auto animate-on-scroll">
      <span class="inline-flex items-center gap-2 rounded-full border border-peach/30 bg-peach/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-peach">
        Our Process
      </span>
      <h2 class="mt-8 text-4xl font-bold text-white sm:text-5xl lg:text-6xl leading-tight">
        From RTL to Silicon
      </h2>
      <p class="mt-6 text-lg text-white/70 leading-relaxed max-w-2xl mx-auto sm:text-xl">
        The center tracks timing, power, and verification in a repeatable pipeline that students can study, optimize, and extend — from raw RTL through sign-off to successful physical tape-out.
      </p>
      <div class="mt-10">
        <a href="/meds-ee-uet/about" class="group inline-flex items-center gap-2 rounded-full bg-peach px-8 py-4 text-sm font-semibold text-brand transition-all duration-300 hover:bg-white hover:shadow-[0_0_40px_rgba(255,230,230,0.2)] hover:-translate-y-0.5">
          Learn about our process
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom curved edge -->
  <div class="absolute bottom-0 left-0 right-0 z-10 pointer-events-none">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-8 sm:h-12" preserveAspectRatio="none">
      <path d="M0 60V30C360 45 1080 15 1440 30V60H0Z" fill="white"/>
    </svg>
  </div>
</section>
