---
import type { Post, Project } from '../lib/types';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

// Combine posts into highlight items
const highlights = posts.map((post) => ({
  type: 'post' as const,
  title: post.title,
  description: post.bodyText?.slice(0, 120) || 'Latest technical notes and research progress from the center.',
  image: post.mainImageUrl,
  href: `/meds-ee-uet/blog/${post.slug}`,
  badge: 'Blog Post',
}));
---

<section class="section-light py-20 lg:py-28" id="highlights-section">
  <div class="container-shell">
    <div class="text-center animate-on-scroll">
      <span class="eyebrow">What's New</span>
      <h2 class="mt-6 text-3xl font-bold text-brand sm:text-4xl lg:text-5xl">Latest Highlights</h2>
      <p class="mt-4 text-lg text-ink/60 max-w-2xl mx-auto">Stay up to date with the latest blog posts and technical notes from MEDS.</p>
    </div>

    <!-- Carousel -->
    <div class="mt-14 relative" id="carousel-wrapper">
      <div class="overflow-hidden rounded-2xl p-2 -m-2">
        <div id="carousel-track" class="flex transition-transform duration-500 ease-out gap-6">
          {highlights.map((item, i) => (
            <a 
              href={item.href} 
              class={`carousel-card flex-shrink-0 w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] group animate-on-scroll delay-${(i % 3) + 1}`}
            >
              <div class="rounded-2xl border border-brand/10 bg-white p-5 transition-all duration-300 hover:border-brand/30 hover:shadow-[0_20px_50px_rgba(89,46,92,0.12)] hover:-translate-y-1.5 h-full flex flex-col justify-between">
                <div>
                  <!-- Image Thumbnail Header -->
                  <div class="relative aspect-[16/9] overflow-hidden rounded-xl bg-peach mb-4 border border-brand/5">
                    {item.image ? (
                      <img 
                        src={item.image} 
                        alt={item.title} 
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                        loading="lazy" 
                      />
                    ) : (
                      <div class="w-full h-full bg-gradient-to-br from-brand-dark to-brand flex items-center justify-center relative p-4">
                        <svg class="w-12 h-12 text-peach/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                        </svg>
                      </div>
                    )}
                    <span class="absolute top-2.5 right-2.5 rounded-full bg-brand-dark/85 px-2.5 py-0.5 text-[10px] font-bold tracking-wide text-peach backdrop-blur-md shadow-sm">
                      {item.badge}
                    </span>
                  </div>

                  <!-- Header Type Badge -->
                  <div class="flex items-center gap-2 pb-2">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-brand/70 bg-brand/5 px-2.5 py-0.5 rounded-full">
                      Technical Note
                    </span>
                  </div>

                  <!-- Title & Description -->
                  <h3 class="mt-2 text-lg font-bold text-brand group-hover:text-brand-light transition-colors line-clamp-2 leading-snug">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-sm text-ink/65 leading-relaxed line-clamp-2">
                    {item.description}
                  </p>
                </div>

                <!-- Footer CTA -->
                <div class="mt-6 pt-4 border-t border-brand/5 flex items-center justify-between">
                  <span class="text-xs font-semibold text-brand/60 group-hover:text-brand transition-colors">
                    Read Full Post
                  </span>
                  <span class="w-8 h-8 rounded-full bg-peach/20 flex items-center justify-center text-brand transition-all duration-300 group-hover:bg-brand group-hover:text-white group-hover:translate-x-1">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Carousel navigation arrows -->
      {highlights.length > 1 && (
        <div class="mt-8 flex justify-center gap-3">
          <button id="carousel-prev" class="rounded-full border border-mauve bg-white p-3 text-brand transition hover:bg-peach hover:border-brand/20 active:scale-95 shadow-sm" aria-label="Previous slide">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button id="carousel-next" class="rounded-full border border-mauve bg-white p-3 text-brand transition hover:bg-peach hover:border-brand/20 active:scale-95 shadow-sm" aria-label="Next slide">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  function initCarousel() {
    const track = document.getElementById('carousel-track');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const wrapper = document.getElementById('carousel-wrapper');
    
    if (!track || !prevBtn || !nextBtn) return;
    
    const cards = Array.from(track.querySelectorAll('.carousel-card'));
    if (cards.length === 0) return;

    let currentIndex = 0;
    let autoPlayTimer = null;

    function getVisibleCount() {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 640) return 2;
      return 1;
    }

    function getMaxIndex() {
      return Math.max(0, cards.length - getVisibleCount());
    }

    function getCardStep() {
      const card = cards[0];
      if (!card) return 0;
      return card.getBoundingClientRect().width + 24; // width + gap
    }

    function updateSlide() {
      const maxIndex = getMaxIndex();
      if (currentIndex > maxIndex) {
        currentIndex = 0;
      } else if (currentIndex < 0) {
        currentIndex = maxIndex;
      }

      const step = getCardStep();
      const offset = currentIndex * step;
      track.style.transform = `translateX(-${offset}px)`;
    }

    function nextSlide() {
      const maxIndex = getMaxIndex();
      if (currentIndex >= maxIndex) {
        currentIndex = 0; // Rotate back to beginning
      } else {
        currentIndex++;
      }
      updateSlide();
    }

    function prevSlide() {
      const maxIndex = getMaxIndex();
      if (currentIndex <= 0) {
        currentIndex = maxIndex; // Rotate to end
      } else {
        currentIndex--;
      }
      updateSlide();
    }

    nextBtn.onclick = (e) => {
      e.preventDefault();
      nextSlide();
      restartAutoPlay();
    };

    prevBtn.onclick = (e) => {
      e.preventDefault();
      prevSlide();
      restartAutoPlay();
    };

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(nextSlide, 4500);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    function restartAutoPlay() {
      stopAutoPlay();
      startAutoPlay();
    }

    if (wrapper) {
      wrapper.onmouseenter = stopAutoPlay;
      wrapper.onmouseleave = startAutoPlay;
    }

    window.onresize = () => {
      updateSlide();
    };

    updateSlide();
    startAutoPlay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
</script>
