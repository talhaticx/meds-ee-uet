---
import type { Post, Project } from '../lib/types';

interface Props {
  posts: Post[];
  projects: Project[];
}

const { posts, projects } = Astro.props;

// Combine posts and projects into highlight items
const highlights = [
  ...posts.map((post) => ({
    type: 'post' as const,
    title: post.title,
    description: post.bodyText?.slice(0, 120) || 'Latest technical notes and research progress from the center.',
    image: post.mainImageUrl,
    href: `/meds-ee-uet/blog/${post.slug}`,
    badge: 'Blog Post',
  })),
  ...projects.map((project) => ({
    type: 'project' as const,
    title: project.title,
    description: project.abstract?.slice(0, 120) || 'Hardware research and development project.',
    image: project.heroImageUrl,
    href: `/meds-ee-uet/projects/${project.slug}`,
    badge: project.status,
  })),
];
---

<section class="section-light py-20 lg:py-28" id="highlights-section">
  <div class="container-shell">
    <div class="text-center animate-on-scroll">
      <span class="eyebrow">What's New</span>
      <h2 class="mt-6 text-3xl font-bold text-brand sm:text-4xl lg:text-5xl">Latest Highlights</h2>
      <p class="mt-4 text-lg text-ink/60 max-w-2xl mx-auto">Stay up to date with the latest research, projects, and announcements from the center.</p>
    </div>

    <!-- Carousel -->
    <div class="mt-14 relative" id="carousel-wrapper">
      <div class="overflow-hidden rounded-2xl">
        <div id="carousel-track" class="flex transition-transform duration-500 ease-out gap-6">
          {highlights.map((item, i) => (
            <a 
              href={item.href} 
              class={`carousel-card flex-shrink-0 w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] group animate-on-scroll delay-${i + 1}`}
            >
              <div class="relative overflow-hidden rounded-2xl bg-brand-dark h-full">
                <!-- Image background -->
                <div class="aspect-[16/10] overflow-hidden">
                  {item.image ? (
                    <img 
                      src={item.image} 
                      alt={item.title} 
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-70"
                      loading="lazy"
                    />
                  ) : (
                    <div class="h-full w-full bg-gradient-to-br from-brand-dark to-brand/50"></div>
                  )}
                </div>
                <!-- Content overlay -->
                <div class="p-6">
                  <span class="inline-flex rounded-full bg-peach/15 px-3 py-1 text-xs font-semibold text-peach uppercase tracking-wider">
                    {item.badge}
                  </span>
                  <h3 class="mt-4 text-xl font-bold text-white group-hover:text-peach transition-colors">{item.title}</h3>
                  <p class="mt-2 text-sm text-white/60 leading-relaxed">{item.description}</p>
                  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-peach group-hover:gap-2 transition-all">
                    Read more 
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Carousel navigation arrows -->
      {highlights.length > 3 && (
        <div class="mt-8 flex justify-center gap-3">
          <button id="carousel-prev" class="rounded-full border border-mauve bg-white p-3 text-brand transition hover:bg-peach hover:border-brand/20" aria-label="Previous slide">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button id="carousel-next" class="rounded-full border border-mauve bg-white p-3 text-brand transition hover:bg-peach hover:border-brand/20" aria-label="Next slide">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      )}
    </div>
  </div>
</section>

<script lang="ts">
  const track = document.getElementById('carousel-track');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  
  if (track && prevBtn && nextBtn) {
    let offset = 0;
    const cards = track.querySelectorAll('.carousel-card');
    
    function getCardWidth() {
      const card = cards[0] as HTMLElement;
      if (!card) return 0;
      return card.offsetWidth + 24;
    }
    
    function getMaxOffset() {
      const trackWidth = Array.from(cards).reduce((sum, card) => sum + (card as HTMLElement).offsetWidth + 24, 0) - 24;
      const containerWidth = (track.parentElement as HTMLElement).offsetWidth;
      return Math.max(0, trackWidth - containerWidth);
    }

    prevBtn.addEventListener('click', () => {
      offset = Math.max(0, offset - getCardWidth());
      track.style.transform = `translateX(-${offset}px)`;
    });

    nextBtn.addEventListener('click', () => {
      offset = Math.min(getMaxOffset(), offset + getCardWidth());
      track.style.transform = `translateX(-${offset}px)`;
    });
  }
</script>
