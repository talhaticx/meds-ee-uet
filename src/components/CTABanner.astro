---
// CTA / Stay Connected banner
---

<section class="relative overflow-hidden py-20 lg:py-28" id="cta-section">
  <div class="absolute inset-0 bg-gradient-to-br from-white via-peach/30 to-mauve/40"></div>
  <div class="absolute top-10 right-10 w-72 h-72 rounded-full bg-brand/5 blur-[80px]"></div>
  <div class="absolute bottom-10 left-10 w-48 h-48 rounded-full bg-peach/30 blur-[60px]"></div>

  <div class="container-shell relative z-10 text-center">
    <div class="max-w-2xl mx-auto animate-on-scroll">
      <h2 class="text-3xl font-bold text-brand sm:text-4xl lg:text-5xl">Stay connected with MEDS</h2>
      <p class="mt-6 text-lg text-ink/60">Get the latest updates on our research, projects, and events.</p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="mailto:contact@meds.edu.pk" class="group inline-flex items-center gap-2 rounded-full bg-brand px-8 py-4 text-sm font-semibold text-white transition-all duration-300 hover:bg-brand/90 hover:shadow-[0_12px_40px_rgba(89,46,92,0.25)] hover:-translate-y-0.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          Contact Us
        </a>
        <a href="https://github.com" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-full border border-brand/20 bg-white px-8 py-4 text-sm font-semibold text-brand transition-all duration-300 hover:bg-peach hover:border-brand/30 hover:-translate-y-0.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          Follow on GitHub
        </a>
      </div>
    </div>
  </div>
</section>
