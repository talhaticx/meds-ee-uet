---
// Research domains grid — brand-dark background with image cards
const domains = [
  {
    title: 'FPGA Accelerators',
    description: 'Custom hardware accelerators for compute-intensive workloads, from neural network inference to signal processing.',
    image: '/meds-ee-uet/images/domain-fpga.png',
    badge: 'Acceleration',
    href: '/meds-ee-uet/projects',
  },
  {
    title: 'RISC-V Processors',
    description: 'Designing open-source RISC-V processor cores, from single-cycle educational designs to pipelined production-ready implementations.',
    image: '/meds-ee-uet/images/domain-riscv.png',
    badge: 'Architecture',
    href: '/meds-ee-uet/projects',
  },
  {
    title: 'Hardware Verification',
    description: 'End-to-end verification methodologies including UVM testbenches, formal verification, and coverage-driven workflows.',
    image: '/meds-ee-uet/images/domain-verification.png',
    badge: 'Verification',
    href: '/meds-ee-uet/projects',
  },
  {
    title: 'SoC Design',
    description: 'Complete system-on-chip integration — from IP selection through floorplanning to sign-off and tape-out readiness.',
    image: '/meds-ee-uet/images/domain-soc.png',
    badge: 'Integration',
    href: '/meds-ee-uet/projects',
  },
];
---

<section class="bg-brand-dark py-20 lg:py-28 relative overflow-hidden text-white" id="domains-section">
  <!-- Background accents -->
  <div class="absolute bottom-0 right-0 w-[500px] h-[500px] rounded-full bg-peach/5 blur-[150px]"></div>

  <div class="container-shell relative z-10">
    <div class="text-center animate-on-scroll">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-peach">
        Research Focus
      </span>
      <h2 class="mt-6 text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        Shaping the future of <span class="bg-gradient-to-r from-peach to-mauve bg-clip-text text-transparent">digital hardware</span>
      </h2>
      <p class="mt-4 text-lg text-white/55 max-w-2xl mx-auto">
        Our research spans the entire hardware design stack — from architecture exploration to physical implementation.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {domains.map((domain, i) => (
        <a 
          href={domain.href} 
          class={`group relative overflow-hidden rounded-2xl bg-brand border border-white/5 transition-all duration-300 hover:border-peach/20 hover:-translate-y-1 hover:shadow-[0_20px_60px_rgba(89,46,92,0.3)] animate-on-scroll delay-${i + 1}`}
        >
          <!-- Image -->
          <div class="aspect-[4/3] overflow-hidden">
            <img 
              src={domain.image} 
              alt={domain.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-80 group-hover:opacity-100"
              loading="lazy"
            />
          </div>
          
          <!-- Dark gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-brand via-brand/60 to-transparent"></div>
          
          <!-- Content -->
          <div class="absolute bottom-0 left-0 right-0 p-5">
            <span class="inline-flex rounded-full bg-peach/15 px-2.5 py-0.5 text-[10px] font-semibold text-peach uppercase tracking-wider">
              {domain.badge}
            </span>
            <h3 class="mt-3 text-lg font-bold text-white group-hover:text-peach transition-colors">{domain.title}</h3>
            <p class="mt-2 text-xs text-white/50 leading-relaxed line-clamp-2">{domain.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
