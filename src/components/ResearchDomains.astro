---
// Research domains grid — brand-dark background with domain images & glowing SVG tech cards
const domains = [
  {
    title: 'FPGA Accelerators',
    description: 'Custom hardware accelerators for compute-intensive workloads, from neural network inference to matrix acceleration.',
    badge: 'Acceleration',
    href: '/meds-ee-uet/projects',
    icon: 'fpga',
    image: '/meds-ee-uet/images/domain-fpga.png',
  },
  {
    title: 'RISC-V Processors',
    description: 'Designing open-source RISC-V processor cores, privilege compliance test generators, and vector accelerators.',
    badge: 'Architecture',
    href: '/meds-ee-uet/projects',
    icon: 'cpu',
    image: '/meds-ee-uet/images/domain-riscv.png',
  },
  {
    title: 'Hardware Verification',
    description: 'End-to-end verification workflows including RISCOF compliance, gem5 simulation, and UVM testbenches.',
    badge: 'Verification',
    href: '/meds-ee-uet/projects',
    icon: 'shield',
    image: '/meds-ee-uet/images/domain-verification.png',
  },
  {
    title: 'SoC Design',
    description: 'Complete system-on-chip integration — from IP selection and AHB/AXI buses to tape-out readiness.',
    badge: 'Integration',
    href: '/meds-ee-uet/projects',
    icon: 'soc',
    image: '/meds-ee-uet/images/domain-soc.png',
  },
];
---

<section class="bg-brand-dark py-20 lg:py-28 relative overflow-hidden text-white" id="domains-section">
  <!-- Background accents -->
  <div class="absolute bottom-0 right-0 w-[500px] h-[500px] rounded-full bg-peach/5 blur-[150px]"></div>
  <div class="absolute top-0 left-0 w-[400px] h-[400px] rounded-full bg-mauve/5 blur-[120px]"></div>

  <div class="container-shell relative z-10">
    <div class="text-center animate-on-scroll">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-peach">
        Research Focus
      </span>
      <h2 class="mt-6 text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        Shaping the future of <span class="bg-gradient-to-r from-peach to-mauve bg-clip-text text-transparent">digital hardware</span>
      </h2>
      <p class="mt-4 text-lg text-white/60 max-w-2xl mx-auto">
        Our research spans the entire hardware design stack — from architecture exploration to physical implementation.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {domains.map((domain, i) => (
        <a 
          href={domain.href} 
          class={`group relative overflow-hidden rounded-2xl bg-white/5 border border-white/10 p-5 transition-all duration-300 hover:border-peach/40 hover:bg-white/[0.08] hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.4)] flex flex-col justify-between animate-on-scroll delay-${i + 1}`}
        >
          <div>
            <!-- Image Thumbnail Banner -->
            <div class="relative aspect-[16/10] overflow-hidden rounded-xl bg-brand/40 mb-5 border border-white/10">
              <img 
                src={domain.image} 
                alt={domain.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-85 group-hover:opacity-100" 
                loading="lazy" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/90 via-brand-dark/30 to-transparent"></div>
              
              <!-- Floating Icon Badge -->
              <div class="absolute bottom-2.5 left-2.5 w-9 h-9 rounded-lg bg-brand-deep/80 border border-peach/40 backdrop-blur-md flex items-center justify-center text-peach group-hover:scale-110 transition-transform">
                {domain.icon === 'fpga' && (
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                  </svg>
                )}
                {domain.icon === 'cpu' && (
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M12 3v1.5M15.75 3v1.5M8.25 19.5V21M12 19.5V21M15.75 19.5V21M3 8.25h1.5M3 12h1.5M3 15.75h1.5M19.5 8.25H21M19.5 12H21M19.5 15.75H21M6.75 6.75h10.5v10.5H6.75V6.75z" />
                  </svg>
                )}
                {domain.icon === 'shield' && (
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751A11.959 11.959 0 0112 2.714z" />
                  </svg>
                )}
                {domain.icon === 'soc' && (
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L12 6.75l5.571 3m0 0l4.179 2.25-4.179 2.25m0 0l-5.571 3-5.571-3m11.142 0L12 17.25l-5.571-3" />
                  </svg>
                )}
              </div>

              <!-- Top Right Badge -->
              <span class="absolute top-2.5 right-2.5 rounded-full bg-brand-deep/80 backdrop-blur-md px-2.5 py-0.5 text-[10px] font-semibold text-peach border border-peach/20 uppercase tracking-wider">
                {domain.badge}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-peach transition-colors">{domain.title}</h3>
            <p class="mt-2 text-sm text-white/65 leading-relaxed">{domain.description}</p>
          </div>

          <!-- Bottom Link -->
          <div class="mt-5 pt-3.5 border-t border-white/10 flex items-center justify-between text-xs font-semibold text-peach group-hover:text-white transition-colors">
            <span>Explore Projects</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
