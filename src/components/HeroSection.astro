---
// Full-viewport hero section with brand purple background and 3D chip image
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-brand-deep" id="hero-section">
  <!-- Background gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-brand-deep via-brand-dark to-brand"></div>
  
  <!-- Subtle grid pattern overlay -->
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

  <!-- Atmospheric glow -->
  <div class="absolute top-1/2 right-1/4 w-[600px] h-[600px] rounded-full bg-peach/10 blur-[180px] pulse-glow"></div>
  <div class="absolute bottom-0 left-1/3 w-[400px] h-[400px] rounded-full bg-mauve/10 blur-[120px] pulse-glow" style="animation-delay: 1.5s;"></div>

  <div class="container-shell relative z-10 pt-24 pb-16">
    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16">
      
      <!-- Left: Text content -->
      <div class="space-y-8" style="animation: fadeInUp 0.8s ease-out both;">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-peach backdrop-blur-sm">
          Advanced Hardware Research Lab
        </span>
        
        <div class="space-y-6">
          <h1 class="max-w-2xl font-extrabold leading-[1.1] tracking-tight">
            <span class="block text-4xl text-white sm:text-5xl lg:text-[3.5rem] xl:text-6xl mb-2">Engineering open silicon at</span>
            <span class="block text-4xl sm:text-5xl lg:text-[3.5rem] xl:text-6xl bg-gradient-to-r from-peach via-mauve to-white bg-clip-text text-transparent">Maktab-e-Digital Systems</span>
          </h1>
          <p class="max-w-xl text-lg leading-relaxed text-white/70 sm:text-xl">
            MEDS is a research center at UET, Lahore, pushing the boundaries of digital logic design, hardware verification, and custom architecture.
          </p>
        </div>
        
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="/meds-ee-uet/projects" class="group inline-flex items-center gap-2 rounded-full bg-peach px-7 py-3.5 text-sm font-semibold text-brand transition-all duration-300 hover:bg-white hover:shadow-[0_0_30px_rgba(255,230,230,0.3)] hover:-translate-y-0.5">
            Explore projects
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
          <a href="/meds-ee-uet/blog" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-300 hover:bg-white/10 hover:border-white/30 hover:-translate-y-0.5">
            Latest updates
          </a>
        </div>

        <!-- Quick stats row -->
        <div class="grid grid-cols-3 gap-6 pt-4 border-t border-white/10 max-w-md">
          <div>
            <p class="text-2xl font-bold text-white sm:text-3xl">12+</p>
            <p class="mt-1 text-xs text-white/50 uppercase tracking-wider">Projects</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-white sm:text-3xl">4</p>
            <p class="mt-1 text-xs text-white/50 uppercase tracking-wider">Focus Areas</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-white sm:text-3xl">24/7</p>
            <p class="mt-1 text-xs text-white/50 uppercase tracking-wider">Lab Access</p>
          </div>
        </div>
      </div>

      <!-- Right: 3D Chip Image -->
      <div class="relative flex items-center justify-center" style="animation: slideInFromRight 1s ease-out 0.3s both;">
        <div class="relative">
          <!-- Glow behind chip -->
          <div class="absolute inset-0 scale-110 rounded-full bg-gradient-to-br from-mauve/20 via-brand-light/20 to-peach/10 blur-[60px]"></div>
          <img 
            src="/meds-ee-uet/images/hero-chip.png" 
            alt="RISC-V System-on-Chip processor render" 
            class="relative w-full max-w-[520px] float-animation drop-shadow-2xl"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Curved bottom edge -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
      <path d="M0 80V60C240 20 480 0 720 0C960 0 1200 20 1440 60V80H0Z" fill="white"/>
    </svg>
  </div>
</section>
